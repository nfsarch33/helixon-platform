# runx-public-repo-gate: allow-file fleet_host_alias,network_topology,secret_cred_ref
[Unit]
Description=Helixon alert notifier (Alertmanager -> email digest)
Documentation=https://github.com/nfsarch33/helixon-platform/tree/main/cmd/alert-notifier
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# --- Credential handling -------------------------------------------------
# RESEND_API_KEY is supplied ONLY through this env file, which is rendered
# out-of-band by secrets-bootstrap (see cmd/secrets-bootstrap) into the
# per-user runtime directory. It is never passed on the command line,
# because argv is world-readable via /proc.
#
# There is deliberately NO op:// reference and no `op` invocation anywhere
# on this unit's startup path: running the 1Password CLI from a service
# start puts it in a background process group, where its terminal read
# raises SIGTTIN and hangs the unit forever with no diagnostic. The secret
# must already be on disk before this unit runs.
#
# /run/user/%U is tmpfs and vanishes on reboot, so this unit renders its own
# env file rather than depending on something else having run first. An
# alerting component that stops alerting at the next reboot is not alerting.
#
# The dash prefix is STRUCTURALLY REQUIRED, not laziness: systemd loads
# EnvironmentFile= BEFORE it spawns ExecStartPre, so a non-optional reference
# to the file that ExecStartPre generates can never be satisfied on a cold
# start -- the unit dies with "Failed to load environment files" before the
# generator ever runs. Verified the hard way on 2026-08-28.
# The 1Password vault name and item UUIDs secrets-bootstrap resolves are NOT
# in the repository -- it is public, and a vault plus a set of item ids is an
# internal map of the secret store. They come from this file, which the
# operator provisions per host from systemd-units/op-items.env.example.
#
# NO dash prefix, and that is the whole point: this reference is REQUIRED.
# systemd loads EnvironmentFile= before it spawns ExecStartPre, so an
# unprovisioned host fails here, at unit start, with "Failed to load
# environment files" naming the path. The alternative -- an optional
# reference -- would let ExecStartPre run with no item ids, and this unit
# exists because a notifier that silently stops notifying is worse than one
# that refuses to start.
#
# Contrast the dash on the line below, which IS structurally required: that
# file is generated by the ExecStartPre underneath it and cannot exist on a
# cold start.
EnvironmentFile=%h/.config/helixon/op-items.env
EnvironmentFile=-/run/user/%U/alert-notifier-env

# Render the credential, then refuse to continue if it did not land.
#
# --strict is the load-bearing flag: without it secrets-bootstrap exits 0 even
# when it resolved nothing, writing a file of "# KEY=<unavailable>" comments.
# ExecStartPre would then be satisfied and the notifier would run with no
# delivery path -- recreating the exact black hole this component exists to end.
# The second check covers the case where the file exists but carries no
# assignment.
#
# secrets-bootstrap invokes `op` with a service-account token, which keeps it
# non-interactive. That is what makes it safe here: a bare `op` on a unit's
# start path can raise SIGTTIN from its background process group and hang the
# unit forever with no diagnostic.
ExecStartPre=/bin/sh -c 'export OP_SERVICE_ACCOUNT_TOKEN=$(cat %h/.config/op/service-account-token) && %h/local/bin/secrets-bootstrap --service alert-notifier --strict --out /run/user/%U/alert-notifier-env'
ExecStartPre=/bin/sh -c 'grep -q "^RESEND_API_KEY=" /run/user/%U/alert-notifier-env || { echo "alert-notifier: no delivery credential rendered; refusing to run" >&2; exit 1; }'

ExecStart=%h/local/bin/alert-notifier \
  --alertmanager-url http://127.0.0.1:9093 \
  --state %h/.local/state/hlxn/alert-notifier-state.json \
  --textfile %h/.local/share/node-exporter-textfile/alert-notifier.prom \
  --renotify 6h \
  --timeout 10s

# The audit NDJSON goes to stdout and lands in the journal; the human
# summary and any error go to stderr.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alert-notifier

# One cycle is one poll plus one bounded send; 120s is generous headroom
# over the process's own 60s internal deadline.
TimeoutStartSec=120

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
