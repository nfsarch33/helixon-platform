# op-items.env -- 1Password references for secrets-bootstrap.
#
# Install as ~/.config/helixon/op-items.env, mode 0600. Both
# fleet-agent.service and alert-notifier.service reference it with a
# NON-optional EnvironmentFile=, so a host without it fails at unit start
# rather than starting a service with no credential.
#
#   install -m 0600 /dev/null ~/.config/helixon/op-items.env
#   $EDITOR ~/.config/helixon/op-items.env
#
# WHY THIS FILE EXISTS
#
# helixon-platform is a PUBLIC repository. A vault name plus a set of item
# ids is not a secret on its own -- reading an item still requires vault
# access -- but together they are an internal map of the secret store: which
# vault exists, which items are in it, and what each one is for. That is the
# class of thing the public-repo-gate job exists to keep out, so the map
# lives here, on the host, and never in the tree.
#
# These are IDENTIFIERS, not credentials. A 1Password item UUID is immutable
# and cannot be rotated without deleting and recreating the item; nothing in
# this file grants access to anything. The actual secret is read at run time
# by `op` using OP_SERVICE_ACCOUNT_TOKEN, which is NOT stored here.
#
# HOW TO FILL IT IN
#
# Every value on the right-hand side is a 26-character item UUID. Use the
# UUID, never the display name: `op read` accepts a display name, which makes
# the reference ambiguous and leaks more than a UUID does. secrets-bootstrap
# rejects anything that is not exactly 26 characters.
#
#   op item list --vault "$HLXN_OP_VAULT" --format json | jq -r '.[] | "\(.id)  \(.title)"'
#
# `secrets-bootstrap --help` prints which variable each service needs.

# The vault every entry resolves against. No default on purpose: a wrong
# default would point `op read` at whatever vault carries that name in the
# caller's account.
HLXN_OP_VAULT=your-vault-name

# --- item references -------------------------------------------------------
#
# Entries that must resolve to the SAME item deliberately share one variable.
# HLXN_OP_ITEM_MINIMAX_1 is read by BOTH engramd's paid embedding fallback
# (ENGRAM_EMBED_KEY) and minimax-quota's key 1 -- that coupling is why key 1
# drains faster than keys 2 and 3. HLXN_OP_ITEM_LLM_ROUTER is read by all
# three llm-cluster-router callers (llm-router, fleet-agent, evospined),
# which authenticate to the router with the same bearer and must never
# diverge. Splitting either is a behaviour change, and a test fails if you do.

# MiniMax coding-plan keys. Ordering is the metric ordinal (key_ordinal=1|2|3).
HLXN_OP_ITEM_MINIMAX_1=aaaaaaaaaaaaaaaaaaaaaaaaaa
HLXN_OP_ITEM_MINIMAX_2=aaaaaaaaaaaaaaaaaaaaaaaaaa
HLXN_OP_ITEM_MINIMAX_3=aaaaaaaaaaaaaaaaaaaaaaaaaa

# SprintBoard API bearer.
HLXN_OP_ITEM_SPRINTBOARD=aaaaaaaaaaaaaaaaaaaaaaaaaa

# llm-cluster-router client-auth bearer (see the shared-item note above).
HLXN_OP_ITEM_LLM_ROUTER=aaaaaaaaaaaaaaaaaaaaaaaaaa

# HelixChannel edge token. Load-bearing for llm-router STARTUP: the router
# refuses to boot when an auth_header node's key expands empty.
HLXN_OP_ITEM_HELIXCHANNEL_GATEWAY=aaaaaaaaaaaaaaaaaaaaaaaaaa

# Service registry bearer.
HLXN_OP_ITEM_SVCREGISTRY=aaaaaaaaaaaaaaaaaaaaaaaaaa

# Resend API key for the Alertmanager-to-email bridge.
#
# HLXN_OP_FIELD_RESEND is a FIELD id, not a label, and that is deliberate:
# this item's field is labelled "api key" WITH A SPACE, and
# `op read op://vault/item/api key` cannot resolve a spaced label. The field
# id is stable and unambiguous. Get it with:
#
#   op item get "$HLXN_OP_ITEM_RESEND" --format json | jq -r '.fields[] | "\(.id)  \(.label)"'
HLXN_OP_ITEM_RESEND=aaaaaaaaaaaaaaaaaaaaaaaaaa
HLXN_OP_FIELD_RESEND=aaaaaaaaaaaaaaaaaaaaaaaaaa
