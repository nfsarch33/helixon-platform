# Per-node fleet-agent template. Usage:
#   systemctl --user enable fleet-agent@node-b.service
#   systemctl --user start  fleet-agent@node-b.service
#
# The instance name (e.g. node-b) is used to resolve:
#   - %h/.config/helixon/%i-fleet-agent.yaml  (config)
#   - 127.0.0.1:86%i0                         (http port, last digit of instance)
#
# All other agents on host-b/node-b, host-c/node-c, host-d/node-d should drop a
# copy of this file and tweak the WorkingDirectory + Tailscale IP.
